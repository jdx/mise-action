amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

local linters = new Mapping<String, Step> {
    // lints GitHub Actions workflows (jdx/jactionlint, security and policy linter for workflows)
    ["jactionlint"] {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml", ".github/actions/**/action.yml", ".github/actions/**/action.yaml", ".github/dependabot.yml", ".github/dependabot.yaml")
        batch = true
        check = new CommandSpec {
            command = "jactionlint {{ files }}"
            effect = "read"
        }
        fix = new CommandSpec {
            command = "jactionlint --fix {{ files }}"
            effect = "write"
        }
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
